# Source documents must not be published (case-insensitive extensions).
*.[hH][wW][pP]
*.[hH][wW][pP][xX]
*.[pP][dD][fF]

# Excel workbooks and templates must not be published.
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[xX][lL][sS][mM]
*.[xX][lL][sS][bB]
*.[xX][lL][tT]
*.[xX][lL][tT][xX]
*.[xX][lL][tT][mM]
*.[xX][lL][aA]
*.[xX][lL][aA][mM]

# Only explicitly curated source roots belong in this mixed local workspace.
/*
!/.gitignore
!/HANDOFF.md
!/README.md
!/HANDOFF.md
!/requirements*.txt
!/support_program_similarity/
!/tests/
!/examples/
!/tools/
!/release/
!/.github/

# Private data, generated outputs, models and archives, even inside allowed roots.
**/__pycache__/
*.pyc
.env
.env.*
*.npy
*.npz
*.gguf
*.safetensors
*.pt
*.bin
*.zip
*.7z
*.tar
*.gz
*.jsonl
*.csv
*.tsv
**/corpus.json
**/pairs.json
**/private_evaluation_mapping.json
**/raw/
**/runs/

