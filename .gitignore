# Only curated source roots belong in this mixed local workspace.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/requirements-inference.txt
!/support_program_similarity/
!/tests/
!/examples/
!/tools/
!/release/
!/.github/
!/experiments/

# Private data, generated outputs, models and archives, even inside allowed roots.
**/__pycache__/
*.pyc
.[eE][nN][vV]*
*.[nN][pP][yY]
*.[nN][pP][zZ]
*.[gG][gG][uU][fF]
